  m_EditorClassIdentifier: Assembly-CSharp::FlowerMerchant
  ShopMenu: {fileID: 0}
  SellMenu: {fileID: 0}
  PlayerHUD: {fileID: 0}
  Crosshair: {fileID: 0}
  dialogue: {fileID: 0}
  dialogueOptionsSpring:
  - Howdy pardner! Weather's lovely today, don'tcha think?
  - If it isn't my favourite witch! Howdy, Hazel!
  - Hazel! Good to see you, how's the wife?
  - Heard about the diagnosis. How are you holdin' up?
  - Got some new seeds this year. Want ta take a look?
  - '

    Woah there girl (horse)'
  dialogueOptionsSummer:
  - Gotta love this summer heat, hey Hazel?
  - Business must be booming for you this season. It sure is for me!
  - Tell your bonny wife I got a surprise for the both of ya. No peeking now!
  - Hazel! My favourite witch. Need any more seeds?
  - My favourites are these sunflowers. Make me a bouquet with 'em, yeah?
  - How's the wife? She must be missing these sunny days. Give her my greetings.
  dialogueOptionsAutumn:
  - Ah, summer came and went. I do love the sight of fallen leaves, though.
  - Feel that chill in the air? Hope you and your wife are keeping warm enough!
  - Hey Hazel, how you been keepin'?
  - Here, take this recipe wit' ya. Your witching remedies ain't got nothing on me
    ma's hot cocoa!
  - I heard chrysanthemum's good for pain relief. Got any witch work with those?
  - Maybe your wife would like this autumn air, it's refreshing. Tell her I say howdy!
  dialogueOptionsWinter:
  - I'm so sorry Hazel
  - "\u2026"
  - "\u2026"
  - "\u2026"
  - "\u2026"
  - "\u2026"
  seasonDialogueOptions: []
  noMoneyDialogue: []
